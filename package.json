{
  "name": "karin",
  "version": "0.1.0",
  "displayVersion": "v.232",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Karin Ã¢â‚¬â€ local Codex session viewer. React 19 + Vite + TS + Tailwind v4. Load-your-own data; transcripts never leave your machine.",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:local": "tsc --noEmit && vite build --mode offline",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "app": "pnpm build && node electron/start.cjs",
    "app:dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && node electron/start.cjs --dev\"",
    "index": "python bin/karin.py",
    "index:watch": "python bin/karin.py --watch",
    "index:claude": "python bin/karin_claude.py",
    "index:claude:watch": "python bin/karin_claude.py --watch",
    "index:warp": "python bin/karin_warp.py",
    "index:warp:watch": "python bin/karin_warp.py --watch"
  },
  "dependencies": {
    "@adomas/dev-tools": "file:../dev-tools",
    "@adomas/json-tree": "file:../json-tree",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^9.1.0"
  }
}
